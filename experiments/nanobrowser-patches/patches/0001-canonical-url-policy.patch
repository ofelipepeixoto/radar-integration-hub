+++ b/src/background/browser/__tests__/urlPolicy.test.ts
@@ -0,0 +1,59 @@
+// Original audit regressions, Carlos Felipe (with AI assistance), 2026-10-07. Apache-2.0.
+import { describe, expect, it } from 'vitest';
+import { isUrlAllowed } from '../util';
+
+describe('URL policy regression', () => {
+  it('does not broaden a port-specific allow rule to other ports', () => {
+    expect(isUrlAllowed('https://example.com:8443/', ['example.com:443'], [])).toBe(false);
+    expect(isUrlAllowed('http://example.com/', ['example.com:443'], [])).toBe(false);
+    expect(isUrlAllowed('https://example.com/', ['example.com:443'], [])).toBe(true);
+  });
+  it('preserves a non-default port in an exact resource rule', () => {
+    expect(isUrlAllowed('http://example.com:8080/page', ['example.com:8080/page'], [])).toBe(true);
+    expect(isUrlAllowed('http://example.com:8081/page', ['example.com:8080/page'], [])).toBe(false);
+  });
+  it.each([
+    'not a url',
+    'java\nscript:alert(1)',
+    'javascript:alert(1)',
+    'data:text/plain,x',
+    'file:///tmp/x',
+    'ftp://example.com',
+    'https://user:pass@example.com/',
+    'https://example.com/a b',
+    '',
+  ])('rejects invalid/unsupported target %j', url => {
+    expect(isUrlAllowed(url, [], [])).toBe(false);
+  });
+  it.each(['https://blocked.example./', 'https://sub.blocked.example/', 'https://BLOCKED.EXAMPLE/'])(
+    'canonical deny covers %s',
+    url => {
+      expect(isUrlAllowed(url, [], ['blocked.example'])).toBe(false);
+    },
+  );
+  it('deny overrides exact resource allow', () => {
+    expect(isUrlAllowed('https://blocked.example/page', ['blocked.example/page'], ['blocked.example'])).toBe(false);
+  });
+  it('matches bracketed IPv6 addresses without truncation', () => {
+    expect(isUrlAllowed('http://[::1]/', [], ['[::1]'])).toBe(false);
+  });
+  it('does not confuse suffix lookalikes with an allowed subdomain', () => {
+    expect(isUrlAllowed('https://evilallowed.example/', ['allowed.example'], [])).toBe(false);
+    expect(isUrlAllowed('https://allowed.example.evil.test/', ['allowed.example'], [])).toBe(false);
+  });
+  it('allows an approved domain and its subdomains', () => {
+    expect(isUrlAllowed('https://sub.allowed.example/path', ['allowed.example'], [])).toBe(true);
+  });
+  it('allows valid web URLs when lists are empty', () => {
+    expect(isUrlAllowed('https://example.com/?x=1', [], [])).toBe(true);
+  });
+  it('preserves explicit blank tab support', () =>
+    expect(isUrlAllowed('about:blank', ['allowed.example'], [])).toBe(true));
+  it('blocks the web store by parsed hostname', () => {
+    expect(isUrlAllowed('https://chromewebstore.google.com./', [], [])).toBe(false);
+  });
+  it('matches only the configured resource when rule includes a path', () => {
+    expect(isUrlAllowed('https://example.com/page?x=1', ['example.com/page?x=1'], [])).toBe(true);
+    expect(isUrlAllowed('https://example.com/other', ['example.com/page?x=1'], [])).toBe(false);
+  });
+});
